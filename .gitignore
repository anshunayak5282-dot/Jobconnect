# ==============================================================================
# JobConnect – Root Git Ignore Specification
# Comprehensive ignore patterns for MERN (React, Node.js, Express, MongoDB)
# ==============================================================================

# ----------------- Dependencies -----------------
node_modules/
*/node_modules/
.pnp
.pnp.js

# ----------------- Environment & Secrets -----------------
# Never commit credentials, JWT secrets, or database connection strings
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ----------------- Build & Distribution -----------------
# Vite, React, Webpack production outputs
dist/
*/dist/
build/
*/build/
out/
.next/
.cache/
.vite/

# ----------------- Logs & Debugging -----------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------- Uploads & User Media -----------------
# Candidate resumes and company logos uploaded dynamically
uploads/
*/uploads/
public/uploads/

# ----------------- Operating System Artifacts -----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ----------------- IDEs & Editors -----------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----------------- Testing & Coverage -----------------
coverage/
.nyc_output/
*.lcov
